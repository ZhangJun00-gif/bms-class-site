ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim
ARG NGINX_IMAGE=docker.io/library/nginx:1.28-alpine
FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY packages/contracts packages/contracts
COPY docs/KNOWLEDGE_BASE_FILE_AUTHORING_GUIDE.md docs/KNOWLEDGE_BASE_FILE_AUTHORING_GUIDE.md
COPY sc sc
RUN pnpm --filter @bmc3/web build

FROM ${NGINX_IMAGE}
ENV NGINX_ENVSUBST_FILTER=^INTRANET_HOST$
ARG NGINX_CONFIG=infra/nginx.conf
COPY ${NGINX_CONFIG} /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80 443
